  "limits": {
    "workflow": {
      "definition_max_bytes": 262144,
      "max_nodes": 64,
      "max_depth": 32,
      "max_fanout": 16,
      "max_node_executions_per_run": 256,
      "max_attempts": 5,
      "node_timeout_ms_min": 1000,
      "node_timeout_ms_max": 86400000,
      "run_timeout_ms_max": 604800000,
      "result_max_bytes": 65536
    },
    "subagent": {
      "max_depth": 2,
      "max_fanout_per_parent": 4,
      "max_concurrent_global": 8,
      "max_context_refs": 32,
      "context_text_max_bytes": 32768,
      "result_max_bytes": 65536,
      "result_summary_max_bytes": 512,
      "injection_payload_max_bytes": 8192,
      "context_max_bytes": 16384,
      "context_verbatim_batches": 8,
      "folded_summary_max_bytes": 2048,
      "result_page_bytes": 16384,
      "result_pages_max": 4,
      "timeout_ms_default": 1800000,
      "timeout_ms_max": 7200000
    },
    "http": {
      "bind_default": "127.0.0.1",
      "port_default": 0,
      "body_max_bytes": 2097152,
      "max_connections": 64,
      "rate_limit_per_sec": 100,
      "auth_message_timeout_ms": 5000,
      "ws_backpressure_queue": 4096
    },
    "import": {
      "file_max_bytes": 21474836480,
      "line_max_bytes": 2097152,
      "buffer_bytes": 1048576,
      "batch_rows": 1000,
      "transaction_target_ms": 500,
      "cleanup_stale_hours": 24
    },
    "attachment": {
      "max_bytes": 10485760,
      "max_per_message": 8,
      "max_per_session": 200,
      "max_dimension": 8192,
      "max_pixels": 25000000,
      "mime_allowlist": ["image/png", "image/jpeg", "image/webp", "image/gif"],
      "thumbnail_max_dimension": 512,
      "orphan_cleanup_hours": 24
    },
    "scheduler": {
      "priority_min": -100,
      "priority_max": 100,
      "wait_boost_per_10s": 1,
      "wait_boost_cap": 60,
      "starvation_guard_ms": 300000,
      "max_queued_per_session": 2,
      "max_queued_global": 64,
      "retry_backoff_ms": [1000, 2000, 4000, 8000, 16000, 30000, 60000]
    },
    "sharding": {
      "dataset_target_bytes": 5368709120,
      "write_p95_threshold_ms": 50,
      "readback_p95_threshold_ms": 150,
      "quick_check_threshold_ms": 30000,
      "backup_threshold_ms": 600000,
      "restore_threshold_ms": 900000
    }
  },
  "risks": [
    {
      "id": "R-M10-01",
      "risk": "编排爆炸半径（深 DAG/大 fan-out/长运行）",
      "owner": "M10-01",
      "mitigation": "nodes<=64/depth<=32/fanout<=16/executions<=256；默认 fail-fast；节点/运行超时；取消级联",
      "trigger": "任一上限被触发或 10 并发出现失控"
    },
    {
      "id": "R-M10-02",
      "risk": "子 Agent 上下文污染/升权/越权读取",
      "owner": "M10-02",
      "mitigation": "显式上下文/引用；不继承父消息全文/工具状态；权限只降不升；默认 message_append（父 system prompt 不变）/后台 origin_fork（不读 live history）/system_replace 仅可选；注入体<=8KiB/上下文<=16KiB/结果<=64KiB；version/supersedes/fold；父可拒绝；parent_session_id 授权；有子会话拒绝删除",
      "trigger": "隔离矩阵/父授权任一失败或出现子会话读父私有状态"
    },
    {
      "id": "R-M10-03",
      "risk": "HTTP/WS 鉴权与攻击面",
      "owner": "M10-03",
      "mitigation": "默认 loopback+随机端口+token；`--stdio` 默认关闭 HTTP；`--http-only` 失败致命；CORS 拒绝；body<=2MiB；速率/连接上限；token 不入 URL/日志；远程绑定需 ADR",
      "trigger": "无 token 请求成功或 token 泄漏"
    },
    {
      "id": "R-M10-04",
      "risk": "导入不可信数据",
      "owner": "M10-04",
      "mitigation": "schema/version/checksum；staging DB + 原子切换；不执行内容；路径/密钥扫描；大小/行上限",
      "trigger": "损坏/恶意样本导致既有数据变化或执行副作用"
    },
    {
      "id": "R-M10-05",
      "risk": "附件增长/解码炸弹/解码库供应链",
      "owner": "M10-05",
      "mitigation": "内容寻址外置；10MiB/8/200/25MP/8192 限额；MIME 魔数；`@napi-rs/image`+`omggif`（MIT）；UtilityProcess 受限进程；保留清理；DB 只存元数据",
      "trigger": "会话附件超限或清理失败"
    },
    {
      "id": "R-M10-06",
      "risk": "i18n 范围蔓延/缺失文案",
      "owner": "M10-06",
      "mitigation": "zh-CN/en-US 两语言；key 100% CI；缺失回退 key；不改后端契约；RTL 不做",
      "trigger": "key 覆盖<100% 或组件硬编码文案"
    },
    {
      "id": "R-M10-07",
      "risk": "调度饥饿/优先级反转",
      "owner": "M10-07",
      "mitigation": "等待时长加权上限；公平性断言；10 并发；队列上限；审计 starvation_guard",
      "trigger": "长队列出现无限等待或超卖"
    },
    {
      "id": "R-M10-08",
      "risk": "事件分库判定失真",
      "owner": "M10-08",
      "mitigation": "固定数据集/脚本/机器信息；写 P95/补读/quick_check/备份恢复全指标；判定表；不实施分库",
      "trigger": "指标越线仍宣称单库可承载"
    }
  ]
}
