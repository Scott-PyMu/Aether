  "required": [
    "id",
    "runtime_id",
    "workspace_id",
    "parent_session_id",
    "title",
    "status",
    "model",
    "provider_id",
    "provider_name",
    "provider_state",
    "model_state",
    "thinking_depth",
    "permission_mode",
    "preset_id",
    "preset_name",
    "system_prompt",
    "config",
    "token_usage",
    "created_at",
    "updated_at",
    "closed_at",
    "workspace_root",
