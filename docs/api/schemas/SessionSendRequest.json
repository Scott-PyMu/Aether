{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "text": {
      "type": "string",
      "maxLength": 1048576
    },
    "client_msg_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "thinking_depth": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "minimum": 0,
      "maximum": 4
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/ReferenceEntry"
      }
    },
    "provider_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "subagent_context": {
      "anyOf": [
        {
          "$ref": "#/components/schemas/SubagentContextInput"
        },
        {
          "type": "null"
        }
      ]
    },
    "attachments": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "priority": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "minimum": -100,
      "maximum": 100
    },
    "timeout_ms": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "max_attempts": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "session_id",
    "text",
    "client_msg_id"
  ]
}
