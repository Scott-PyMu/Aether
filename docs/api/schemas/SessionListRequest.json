{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "runtime_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/components/schemas/SessionStatus"
        },
        {
          "type": "null"
        }
      ]
    },
    "limit": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "minimum": 1,
      "maximum": 500
    }
  },
  "maxProperties": 0
}
