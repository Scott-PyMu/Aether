{
  "schema": "aether.m9-01.command-baseline.v1",
  "command": "provider_update",
  "index": 43,
  "route": "daemon",
  "exposure": "ui",
  "reachable": true,
  "params": {
    "style": "strict",
    "dto": "ProviderUpdateRequest",
    "required": [
      "id",
      "name",
      "enabled"
    ],
    "optional": [
      "base_url",
      "endpoints",
      "api_key"
    ],
    "field_types": {
      "id": "String",
      "name": "String",
      "base_url": "Option<String>",
      "endpoints": "Option<BTreeMap<String, String>>",
      "api_key": "Option<String>",
      "enabled": "bool"
    }
  },
  "accepted_shape": {
    "id": "sample",
    "name": "sample",
    "enabled": true
  },
  "rejects": [
    {
      "id": "unknown_field",
      "stage": "strict_parse",
      "params": {
        "__unexpected_field": true
      },
      "expect": {
        "result": "rejected",
        "code": "unknown_field",
        "field": "__unexpected_field"
      }
    },
    {
      "id": "invalid_json",
      "stage": "strict_parse",
      "params": [],
      "expect": {
        "result": "rejected",
        "code": "invalid_json"
      }
    },
    {
      "id": "missing_field",
      "stage": "strict_parse",
      "params": {},
      "expect": {
        "result": "rejected",
        "code": "missing_field",
        "field": "id"
      }
    },
    {
      "id": "invalid_type",
      "stage": "strict_parse",
      "params": {
        "id": 12345
      },
      "expect": {
        "result": "rejected",
        "code": "invalid_type"
      }
    }
  ],
  "note": "rejects 的期望码由 strict 解析（deny_unknown_fields）确定性给出；accepted_shape 只声明请求形态，不声明后端成功。响应体 golden 由 M9-04 追加，不改本文件。"
}
