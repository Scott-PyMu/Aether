{
  "schema": "aether.m9-01.command-baseline.v1",
  "command": "attachment_add",
  "index": 84,
  "route": "daemon",
  "exposure": "ui",
  "reachable": true,
  "params": {
    "style": "strict",
    "dto": "AttachmentAddRequest",
    "required": [
      "session_id",
      "source_path"
    ],
    "optional": [
      "kind"
    ],
    "field_types": {
      "session_id": "String",
      "source_path": "String",
      "kind": "Option<String>"
    }
  },
  "accepted_shape": {
    "session_id": "01J00000000000000000000000",
    "source_path": "E:\\aether-baseline\\sample"
  },
  "rejects": [
    {
      "id": "unknown_field",
      "stage": "strict_parse",
      "params": {
        "__unexpected_field": true
      },
      "expect": {
        "result": "rejected",
        "code": "unknown_field",
        "field": "__unexpected_field"
      }
    },
    {
      "id": "invalid_json",
      "stage": "strict_parse",
      "params": [],
      "expect": {
        "result": "rejected",
        "code": "invalid_json"
      }
    },
    {
      "id": "missing_field",
      "stage": "strict_parse",
      "params": {},
      "expect": {
        "result": "rejected",
        "code": "missing_field",
        "field": "session_id"
      }
    },
    {
      "id": "invalid_type",
      "stage": "strict_parse",
      "params": {
        "session_id": 12345
      },
      "expect": {
        "result": "rejected",
        "code": "invalid_type"
      }
    }
  ],
  "note": "rejects 的期望码由 strict 解析（deny_unknown_fields）确定性给出；accepted_shape 只声明请求形态，不声明后端成功。响应体 golden 由 M9-04 追加，不改本文件。"
}
