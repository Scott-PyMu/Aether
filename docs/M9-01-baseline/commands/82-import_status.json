{
  "schema": "aether.m9-01.command-baseline.v1",
  "command": "import_status",
  "index": 82,
  "route": "daemon",
  "exposure": "ui",
  "reachable": true,
  "params": {
    "style": "strict",
    "dto": "ImportStatusRequest",
    "required": [
      "job_id"
    ],
    "optional": [
      "include_warnings"
    ],
    "field_types": {
      "job_id": "String",
      "include_warnings": "Option<bool>"
    }
  },
  "accepted_shape": {
    "job_id": "sample"
  },
  "rejects": [
    {
      "id": "unknown_field",
      "stage": "strict_parse",
      "params": {
        "__unexpected_field": true
      },
      "expect": {
        "result": "rejected",
        "code": "unknown_field",
        "field": "__unexpected_field"
      }
    },
    {
      "id": "invalid_json",
      "stage": "strict_parse",
      "params": [],
      "expect": {
        "result": "rejected",
        "code": "invalid_json"
      }
    },
    {
      "id": "missing_field",
      "stage": "strict_parse",
      "params": {},
      "expect": {
        "result": "rejected",
        "code": "missing_field",
        "field": "job_id"
      }
    },
    {
      "id": "invalid_type",
      "stage": "strict_parse",
      "params": {
        "job_id": 12345
      },
      "expect": {
        "result": "rejected",
        "code": "invalid_type"
      }
    }
  ],
  "note": "rejects 的期望码由 strict 解析（deny_unknown_fields）确定性给出；accepted_shape 只声明请求形态，不声明后端成功。响应体 golden 由 M9-04 追加，不改本文件。"
}
