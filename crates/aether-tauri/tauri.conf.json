{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aether",
  "identifier": "dev.aether.app",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. --filter @aether/desktop dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir ../.. --filter @aether/desktop build",
    "frontendDist": "../../apps/desktop/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Aether",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
